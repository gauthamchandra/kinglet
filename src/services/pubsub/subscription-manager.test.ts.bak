test('SubscriptionManager - should handle validation errors gracefully', async () => {
  const request: CreateSubscriptionRequest = {
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic',
    filter: 'a'.repeat(1001) // Filter too long
  };

  // Validation errors are thrown before the try/catch in createSubscription,
  // so they won't be logged as "Failed to create subscription"
  await expect(subscriptionManager.createSubscription(request)).rejects.toThrow(ValidationError);
  await expect(subscriptionManager.createSubscription(request)).rejects.toThrow('Filter expression too long');
});

test('SubscriptionManager - should handle database errors gracefully', async () => {
  const request: CreateSubscriptionRequest = {
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic'
  };

  mockStorage.findFirst.mockRejectedValueOnce(new Error('Database connection failed'));

  await expect(subscriptionManager.createSubscription(request)).rejects.toThrow('Database connection failed');
  expect(mockLogger.error).toHaveBeenCalledWith(
    'Failed to create subscription projects/test-project/subscriptions/test-subscription:',
    expect.any(Error)
  );
});

test('SubscriptionManager - should log operations appropriately', async () => {
  const request: CreateSubscriptionRequest = {
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic'
  };

  mockStorage.findFirst.mockResolvedValueOnce(null);

  await subscriptionManager.createSubscription(request);

  expect(mockLogger.info).toHaveBeenCalledWith('Creating subscription: projects/test-project/subscriptions/test-subscription');
  expect(mockLogger.info).toHaveBeenCalledWith(expect.stringContaining('Subscription created successfully'));
});