test('SubscriptionManager - createSubscription should reject push subscription with message ordering', async () => {
  const request: CreateSubscriptionRequest = {
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic',
    pushConfig: {
      pushEndpoint: 'https://example.com/webhook'
    },
    enableMessageOrdering: true
  };

  await expect(subscriptionManager.createSubscription(request)).rejects.toThrow(ValidationError);
  await expect(subscriptionManager.createSubscription(request)).rejects.toThrow('Message ordering is not supported for push subscriptions');
});

test('SubscriptionManager - createSubscription should accept valid configurations', async () => {
  const request: CreateSubscriptionRequest = {
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic',
    ackDeadlineSeconds: 60,
    retainAckedMessages: true,
    messageRetentionDuration: '600s',
    enableExactlyOnceDelivery: true,
    deadLetterPolicy: {
      deadLetterTopic: 'projects/test-project/topics/dead-letter',
      maxDeliveryAttempts: 10
    },
    retryPolicy: {
      minimumBackoff: '1s',
      maximumBackoff: '60s'
    },
    expirationPolicy: {
      ttl: '24h'
    }
  };

  mockStorage.findFirst.mockResolvedValueOnce(null);

  const subscription = await subscriptionManager.createSubscription(request);

  expect(subscription.ackDeadlineSeconds).toBe(60);
  expect(subscription.retainAckedMessages).toBe(true);
  expect(subscription.messageRetentionDuration).toBe('600s');
  expect(subscription.enableExactlyOnceDelivery).toBe(true);
  expect(subscription.deadLetterPolicy).toEqual({
    deadLetterTopic: 'projects/test-project/topics/dead-letter',
    maxDeliveryAttempts: 10
  });
});

test('SubscriptionManager - getSubscription should return existing subscription', async () => {
  const mockStorageRecord = {
    id: 'sub-123',
    createdAt: '2024-01-01T00:00:00.000Z',
    updatedAt: '2024-01-01T00:00:00.000Z',
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic',
    labels: JSON.stringify({ env: 'test' }),
    ackDeadlineSeconds: 30,
    retainAckedMessages: 0,
    enableMessageOrdering: 0,
    detached: 0,
    enableExactlyOnceDelivery: 0,
    state: 'ACTIVE',
    projectId: 'test-project',
    subscriptionId: 'test-subscription',
    topicId: 'test-topic'
  };

  mockStorage.findFirst.mockResolvedValueOnce(mockStorageRecord);

  const subscription = await subscriptionManager.getSubscription('projects/test-project/subscriptions/test-subscription');

  expect(subscription).toBeDefined();
  expect(subscription?.name).toBe('projects/test-project/subscriptions/test-subscription');
  expect(mockLogger.debug).toHaveBeenCalledWith('Getting subscription: projects/test-project/subscriptions/test-subscription');
});

test('SubscriptionManager - getSubscription should return null for non-existent subscription', async () => {
  mockStorage.findFirst.mockResolvedValueOnce(null);

  const subscription = await subscriptionManager.getSubscription('projects/test-project/subscriptions/non-existent');

  expect(subscription).toBeNull();
  expect(mockLogger.debug).toHaveBeenCalledWith('Subscription not found: projects/test-project/subscriptions/non-existent');
});

test('SubscriptionManager - getSubscription should validate subscription name', async () => {
  await expect(subscriptionManager.getSubscription('invalid-subscription-name')).rejects.toThrow(ValidationError);
});

test('SubscriptionManager - updateSubscription should update existing subscription', async () => {
  const existingSubscription: SubscriptionRecord = {
    id: 'sub-123',
    createdAt: new Date('2024-01-01'),
    updatedAt: new Date('2024-01-01'),
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic',
    labels: { env: 'test' },
    ackDeadlineSeconds: 10,
    retainAckedMessages: false,
    enableMessageOrdering: false,
    detached: false,
    enableExactlyOnceDelivery: false,
    state: 'ACTIVE',
    projectId: 'test-project',
    subscriptionId: 'test-subscription',
    topicId: 'test-topic'
  };

  // Mock findFirst for initial findByName call
  mockStorage.findFirst.mockResolvedValueOnce({
    id: existingSubscription.id,
    createdAt: existingSubscription.createdAt.toISOString(),
    updatedAt: existingSubscription.updatedAt.toISOString(),
    name: existingSubscription.name,
    topic: existingSubscription.topic,
    labels: JSON.stringify(existingSubscription.labels),
    ackDeadlineSeconds: existingSubscription.ackDeadlineSeconds,
    retainAckedMessages: 0,
    enableMessageOrdering: 0,
    detached: 0,
    enableExactlyOnceDelivery: 0,
    state: existingSubscription.state,
    projectId: existingSubscription.projectId,
    subscriptionId: existingSubscription.subscriptionId,
    topicId: existingSubscription.topicId
  });

  // Mock findById for repository.updateById call
  mockStorage.findById.mockResolvedValueOnce({
    id: existingSubscription.id,
    createdAt: existingSubscription.createdAt.toISOString(),
    updatedAt: existingSubscription.updatedAt.toISOString(),
    name: existingSubscription.name,
    topic: existingSubscription.topic,
    labels: JSON.stringify(existingSubscription.labels),
    ackDeadlineSeconds: existingSubscription.ackDeadlineSeconds,
    retainAckedMessages: 0,
    enableMessageOrdering: 0,
    detached: 0,
    enableExactlyOnceDelivery: 0,
    state: existingSubscription.state,
    projectId: existingSubscription.projectId,
    subscriptionId: existingSubscription.subscriptionId,
    topicId: existingSubscription.topicId
  });

  const request: UpdateSubscriptionRequest = {
    labels: { env: 'prod', version: '1.0' },
    ackDeadlineSeconds: 60,
    retainAckedMessages: true
  };

  const updatedSubscription = await subscriptionManager.updateSubscription(
    'projects/test-project/subscriptions/test-subscription',
    request
  );

  expect(updatedSubscription).toBeDefined();
  expect(updatedSubscription?.labels).toEqual({ env: 'prod', version: '1.0' });
  expect(updatedSubscription?.ackDeadlineSeconds).toBe(60);
  expect(updatedSubscription?.retainAckedMessages).toBe(true);
  expect(mockLogger.info).toHaveBeenCalledWith('Updating subscription: projects/test-project/subscriptions/test-subscription');
  expect(mockStorage.updateById).toHaveBeenCalled();
});

test('SubscriptionManager - updateSubscription should return null for non-existent subscription', async () => {
  mockStorage.findFirst.mockResolvedValueOnce(null);

  const request: UpdateSubscriptionRequest = {
    labels: { env: 'prod' }
  };

  const result = await subscriptionManager.updateSubscription(
    'projects/test-project/subscriptions/non-existent',
    request
  );

  expect(result).toBeNull();
  expect(mockLogger.warn).toHaveBeenCalledWith('Subscription not found for update: projects/test-project/subscriptions/non-existent');
});

test('SubscriptionManager - updateSubscription should validate subscription name', async () => {
  const request: UpdateSubscriptionRequest = {
    labels: { env: 'prod' }
  };

  await expect(subscriptionManager.updateSubscription('invalid-subscription-name', request)).rejects.toThrow(ValidationError);
});

test('SubscriptionManager - deleteSubscription should delete existing subscription', async () => {
  const mockSubscription = {
    id: 'sub-123',
    name: 'projects/test-project/subscriptions/test-subscription'
  };

  mockStorage.findFirst.mockResolvedValueOnce(mockSubscription);
  mockStorage.deleteById.mockResolvedValueOnce(true);

  const result = await subscriptionManager.deleteSubscription('projects/test-project/subscriptions/test-subscription');

  expect(result).toBe(true);
  expect(mockLogger.info).toHaveBeenCalledWith('Deleting subscription: projects/test-project/subscriptions/test-subscription');
  expect(mockLogger.info).toHaveBeenCalledWith('Subscription deleted successfully: projects/test-project/subscriptions/test-subscription');
});

test('SubscriptionManager - deleteSubscription should return false for non-existent subscription', async () => {
  mockStorage.findFirst.mockResolvedValueOnce(null);

  const result = await subscriptionManager.deleteSubscription('projects/test-project/subscriptions/non-existent');

  expect(result).toBe(false);
  expect(mockLogger.warn).toHaveBeenCalledWith('Subscription not found for deletion: projects/test-project/subscriptions/non-existent');
});

test('SubscriptionManager - deleteSubscription should validate subscription name', async () => {
  await expect(subscriptionManager.deleteSubscription('invalid-subscription-name')).rejects.toThrow(ValidationError);
});

test('SubscriptionManager - listSubscriptions should list subscriptions with pagination', async () => {
  const mockStorageResult = {
    items: [
      {
        id: 'sub-1',
        createdAt: '2024-01-01T00:00:00.000Z',
        updatedAt: '2024-01-01T00:00:00.000Z',
        name: 'projects/test-project/subscriptions/sub-1',
        topic: 'projects/test-project/topics/test-topic',
        labels: JSON.stringify({ env: 'test' }),
        ackDeadlineSeconds: 30,
        retainAckedMessages: 0,
        enableMessageOrdering: 0,
        detached: 0,
        enableExactlyOnceDelivery: 0,
        state: 'ACTIVE',
        projectId: 'test-project',
        subscriptionId: 'sub-1',
        topicId: 'test-topic'
      },
      {
        id: 'sub-2',
        createdAt: '2024-01-01T00:00:00.000Z',
        updatedAt: '2024-01-01T00:00:00.000Z',
        name: 'projects/test-project/subscriptions/sub-2',
        topic: 'projects/test-project/topics/test-topic',
        labels: JSON.stringify({ env: 'prod' }),
        ackDeadlineSeconds: 60,
        retainAckedMessages: 1,
        enableMessageOrdering: 1,
        detached: 0,
        enableExactlyOnceDelivery: 1,
        state: 'ACTIVE',
        projectId: 'test-project',
        subscriptionId: 'sub-2',
        topicId: 'test-topic'
      }
    ],
    totalCount: 2,
    hasMore: false
  };

  mockStorage.find.mockResolvedValueOnce(mockStorageResult);

  const request: ListSubscriptionsRequest = {
    projectId: 'test-project',
    pageSize: 10
  };

  const response = await subscriptionManager.listSubscriptions(request);

  expect(response.subscriptions).toHaveLength(2);
  expect(response.subscriptions[0]?.name).toBe('projects/test-project/subscriptions/sub-1');
  expect(response.subscriptions[1]?.name).toBe('projects/test-project/subscriptions/sub-2');
  expect(response.totalSize).toBe(2);
  expect(response.nextPageToken).toBeUndefined();
});

test('SubscriptionManager - listSubscriptions should generate next page token when hasMore is true', async () => {
  const mockStorageResult = {
    items: [
      {
        id: 'sub-1',
        createdAt: '2024-01-01T00:00:00.000Z',
        updatedAt: '2024-01-01T00:00:00.000Z',
        name: 'projects/test-project/subscriptions/sub-1',
        topic: 'projects/test-project/topics/test-topic',
        labels: JSON.stringify({}),
        ackDeadlineSeconds: 10,
        retainAckedMessages: 0,
        enableMessageOrdering: 0,
        detached: 0,
        enableExactlyOnceDelivery: 0,
        state: 'ACTIVE',
        projectId: 'test-project',
        subscriptionId: 'sub-1',
        topicId: 'test-topic'
      }
    ],
    totalCount: 10,
    hasMore: true
  };

  mockStorage.find.mockResolvedValueOnce(mockStorageResult);

  const request: ListSubscriptionsRequest = {
    projectId: 'test-project',
    pageSize: 1
  };

  const response = await subscriptionManager.listSubscriptions(request);

  expect(response.subscriptions).toHaveLength(1);
  expect(response.nextPageToken).toBeDefined();
  expect(response.totalSize).toBe(10);
});

test('SubscriptionManager - listSubscriptions should handle page token', async () => {
  const pageToken = Buffer.from('10').toString('base64'); // Offset of 10

  const mockStorageResult = {
    items: [],
    totalCount: 20,
    hasMore: false
  };

  mockStorage.find.mockResolvedValueOnce(mockStorageResult);

  const request: ListSubscriptionsRequest = {
    projectId: 'test-project',
    pageToken
  };

  await subscriptionManager.listSubscriptions(request);

  expect(mockStorage.find).toHaveBeenCalledWith('pubsub_subscriptions', expect.objectContaining({
    offset: 10
  }));
});

test('SubscriptionManager - listSubscriptions should validate request', async () => {
  const request: ListSubscriptionsRequest = {
