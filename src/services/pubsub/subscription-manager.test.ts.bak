/**
 * Unit tests for Subscription Manager
 */

import { test, expect, mock, beforeEach, afterEach } from 'bun:test';
import { ValidationError } from '@/core/storage/types.js';
import type { IStorageManager } from '@/core/storage/interfaces.js';
import type { Logger } from '@/shared/utils/logger.js';
import {
  SubscriptionManager,
  type CreateSubscriptionRequest,
  type UpdateSubscriptionRequest,
  type ListSubscriptionsRequest
} from './subscription-manager.js';
import type { SubscriptionRecord } from './models.js';

// Mock logger
const mockLogger: Logger = {
  debug: mock(() => {}),
  info: mock(() => {}),
  warn: mock(() => {}),
  error: mock(() => {}),
  trace: mock(() => {}),
  fatal: mock(() => {})
};

// Mock storage manager
const mockStorage: IStorageManager = {
  initialize: mock(() => Promise.resolve()),
  getProvider: mock(() => null as any),
  getCache: mock(() => null),
  withTransaction: mock(() => Promise.resolve()),
  createTable: mock(() => Promise.resolve()),
  dropTable: mock(() => Promise.resolve()),
  listTables: mock(() => Promise.resolve([])),
  healthCheck: mock(() => Promise.resolve(true)),
  getStats: mock(() => Promise.resolve({} as any)),
  close: mock(() => Promise.resolve()),
  create: mock(() => Promise.resolve()),
  findById: mock(() => Promise.resolve(null)),
  find: mock(() => Promise.resolve({ items: [], totalCount: 0, hasMore: false })),
  findFirst: mock(() => Promise.resolve(null)),
  updateById: mock(() => Promise.resolve()),
  deleteById: mock(() => Promise.resolve(false)),
  exists: mock(() => Promise.resolve(false)),
  count: mock(() => Promise.resolve(0))
};

let subscriptionManager: SubscriptionManager;

beforeEach(() => {
  subscriptionManager = new SubscriptionManager(mockStorage, mockLogger);

  // Reset all mocks
  Object.values(mockStorage).forEach(mockFn => {
    if (typeof mockFn === 'function' && 'mockReset' in mockFn) {
      mockFn.mockReset();
    }
  });
  Object.values(mockLogger).forEach(mockFn => {
    if (typeof mockFn === 'function' && 'mockReset' in mockFn) {
      mockFn.mockReset();
    }
  });
});

afterEach(() => {
  // Clean up after each test
  Object.values(mockStorage).forEach(mockFn => {
    if (typeof mockFn === 'function' && 'mockReset' in mockFn) {
      mockFn.mockReset();
    }
  });
  Object.values(mockLogger).forEach(mockFn => {
    if (typeof mockFn === 'function' && 'mockReset' in mockFn) {
      mockFn.mockReset();
    }
  });
});

test('SubscriptionManager - initialize should initialize successfully', async () => {
  await subscriptionManager.initialize();

  expect(mockLogger.info).toHaveBeenCalledWith('Initializing Subscription Manager');
  expect(mockLogger.info).toHaveBeenCalledWith('Subscription Manager initialized successfully');
  expect(mockStorage.createTable).toHaveBeenCalled();
});

test('SubscriptionManager - createSubscription should create valid subscription', async () => {
  const request: CreateSubscriptionRequest = {
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic',
    labels: { env: 'test' },
    ackDeadlineSeconds: 30
  };

  mockStorage.findFirst.mockResolvedValueOnce(null); // No existing subscription

  const subscription = await subscriptionManager.createSubscription(request);

  expect(subscription).toMatchObject({
    name: 'projects/test-project/subscriptions/test-subscription',
    topic: 'projects/test-project/topics/test-topic',
    labels: { env: 'test' },
    ackDeadlineSeconds: 30,
    projectId: 'test-project',
    subscriptionId: 'test-subscription',
    topicId: 'test-topic'
  });
  expect(mockLogger.info).toHaveBeenCalledWith('Creating subscription: projects/test-project/subscriptions/test-subscription');
  expect(mockStorage.create).toHaveBeenCalled();
});

test('SubscriptionManager - createSubscription should validate subscription name', async () => {
  const request: CreateSubscriptionRequest = {
    name: 'invalid-subscription-name',
    topic: 'projects/test-project/topics/test-topic'
  };

  await expect(subscriptionManager.createSubscription(request)).rejects.toThrow(ValidationError);
  await expect(subscriptionManager.createSubscription(request)).rejects.toThrow('Invalid subscription name');
});

