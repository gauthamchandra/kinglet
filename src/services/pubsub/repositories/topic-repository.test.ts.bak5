test('TopicRepository - should handle complex objects in storage conversion', async () => {
  const topicData: CreateTopicData = {
    name: 'projects/test-project/topics/complex-topic',
    labels: { env: 'test', version: '1.0' },
    messageStoragePolicy: {
      allowedPersistenceRegions: ['us-central1', 'us-east1']
    },
    schemaSettings: {
      schema: 'projects/test-project/schemas/test-schema',
      encoding: 'JSON',
      firstRevisionId: 'rev-1',
      lastRevisionId: 'rev-2'
    },
    satisfiesPzs: true
  };

  mockResolvedValueOnce(mockStorage.findFirst, null);

  const topic = await repository.create(topicData);

  // Verify the create call was made with properly serialized data
  expect(mockStorage.create).toHaveBeenCalledWith('pubsub_topics', expect.objectContaining({
    name: 'projects/test-project/topics/complex-topic',
    labels: JSON.stringify({ env: 'test', version: '1.0' }),
    messageStoragePolicy: JSON.stringify({
      allowedPersistenceRegions: ['us-central1', 'us-east1']
    }),
    schemaSettings: JSON.stringify({
      schema: 'projects/test-project/schemas/test-schema',
      encoding: 'JSON',
      firstRevisionId: 'rev-1',
      lastRevisionId: 'rev-2'
    }),
    satisfiesPzs: 1,
    projectId: 'test-project',
    topicId: 'complex-topic'
  }));

  // Verify the returned object has proper types
  expect(topic.labels).toEqual({ env: 'test', version: '1.0' });
  expect(topic.messageStoragePolicy).toEqual({
    allowedPersistenceRegions: ['us-central1', 'us-east1']
  });
  expect(topic.schemaSettings).toEqual({
    schema: 'projects/test-project/schemas/test-schema',
    encoding: 'JSON',
    firstRevisionId: 'rev-1',
    lastRevisionId: 'rev-2'
  });
  expect(topic.satisfiesPzs).toBe(true);
});