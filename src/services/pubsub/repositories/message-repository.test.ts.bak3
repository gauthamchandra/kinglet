test('MessageRepository - createSubscriptionLease should create lease', async () => {
  const leaseData = {
    messageId: 'msg-456',
    subscriptionName: 'projects/test-project/subscriptions/test-sub',
    ackId: 'ack-123',
    leaseDeadline: new Date(Date.now() + 60000),
    deliveryAttempts: 1
  };

  const lease = await repository.createSubscriptionLease(leaseData);

  expect(lease).toMatchObject({
    messageId: 'msg-456',
    subscriptionName: 'projects/test-project/subscriptions/test-sub',
    ackId: 'ack-123',
    deliveryAttempts: 1,
    projectId: 'test-project',
    subscriptionId: 'test-sub'
  });
  expect(lease.id).toBeDefined();
  expect(lease.createdAt).toBeInstanceOf(Date);
  expect(lease.updatedAt).toBeInstanceOf(Date);
  expect(lease.leaseDeadline).toBeInstanceOf(Date);
  expect(mockStorage.create).toHaveBeenCalledWith('pubsub_subscription_leases', expect.any(Object));
});

test('MessageRepository - createSubscriptionLease should throw error for invalid subscription name', async () => {
  const leaseData = {
