test('MessageRepository - should handle complex JSON serialization', async () => {
  const messageData: CreateMessageData = {
    messageId: 'msg-123',
    topic: 'projects/test-project/topics/test-topic',
    data: 'SGVsbG8gV29ybGQ=',
    attributes: {
      'complex-key': 'complex value with spaces',
      'unicode': 'émojis 🚀 and special chars',
      'number': '42'
    },
    orderingKey: 'order-key-with-special-chars_123',
    size: 100,
    expirationTime: new Date('2024-12-31T23:59:59Z')
  };

  const message = await repository.create(messageData);

  // Verify the create call was made with properly serialized data
  expect(mockStorage.create).toHaveBeenCalledWith('pubsub_messages', expect.objectContaining({
    messageId: 'msg-123',
    topic: 'projects/test-project/topics/test-topic',
    data: 'SGVsbG8gV29ybGQ=',
    attributes: JSON.stringify({
      'complex-key': 'complex value with spaces',
      'unicode': 'émojis 🚀 and special chars',
      'number': '42'
    }),
    orderingKey: 'order-key-with-special-chars_123',
    size: 100,
    expirationTime: '2024-12-31T23:59:59.000Z',
    deliveryAttempts: 0,
    acknowledged: 0,
    projectId: 'test-project',
    topicId: 'test-topic'
  }));

  // Verify the returned object has proper types
  expect(message.attributes).toEqual({
    'complex-key': 'complex value with spaces',
    'unicode': 'émojis 🚀 and special chars',
    'number': '42'
  });
  expect(message.expirationTime).toBeInstanceOf(Date);
  expect(message.expirationTime?.toISOString()).toBe('2024-12-31T23:59:59.000Z');
});