/**
 * Unit tests for Message Repository
 */

import { test, expect, mock, beforeEach, afterEach } from 'bun:test';
import { ValidationError } from '@/core/storage/types.js';
import type { IStorageManager } from '@/core/storage/interfaces.js';
import type { QueryResult } from '@/core/storage/types.js';
import { MessageRepository, type CreateMessageData } from './message-repository.js';
import type { MessageRecord } from '../models.js';
import { createMockStorage, mockResolvedValueOnce, mockRejectedValueOnce, mockReset } from '../../../test-utils/mock-storage.js';

// Mock storage manager
const mockStorage = createMockStorage();

let repository: MessageRepository;

beforeEach(() => {
  repository = new MessageRepository(mockStorage);

  // Reset all mocks
  Object.values(mockStorage).forEach(mockFn => {
    if (typeof mockFn === 'function' && 'mockReset' in mockFn) {
      mockFn.mockReset();
    }
  });
});

afterEach(() => {
  // Clean up after each test
  Object.values(mockStorage).forEach(mockFn => {
    if (typeof mockFn === 'function' && 'mockReset' in mockFn) {
      mockFn.mockReset();
    }
  });
});

test('MessageRepository - initialize should create tables', async () => {
  await repository.initialize();

  expect(mockStorage.createTable).toHaveBeenCalledTimes(2);
  expect(mockStorage.createTable).toHaveBeenCalledWith('pubsub_messages', expect.any(Object));
  expect(mockStorage.createTable).toHaveBeenCalledWith('pubsub_subscription_leases', expect.any(Object));
});

test('MessageRepository - create should create valid message', async () => {
  const messageData: CreateMessageData = {
    messageId: 'msg-123',
    topic: 'projects/test-project/topics/test-topic',
    data: Buffer.from('Hello, World!').toString('base64'),
    attributes: { key: 'value' },
    orderingKey: 'order-1',
    size: 13
  };

  const message = await repository.create(messageData);

  expect(message).toMatchObject({
    messageId: 'msg-123',
    topic: 'projects/test-project/topics/test-topic',
    data: Buffer.from('Hello, World!').toString('base64'),
    attributes: { key: 'value' },
    orderingKey: 'order-1',
    size: 13,
    deliveryAttempts: 0,
    acknowledged: false,
    projectId: 'test-project',
    topicId: 'test-topic'
  });
  expect(message.id).toBeDefined();
  expect(message.createdAt).toBeInstanceOf(Date);
  expect(message.updatedAt).toBeInstanceOf(Date);
  expect(message.publishTime).toBeInstanceOf(Date);
  expect(mockStorage.create).toHaveBeenCalledWith('pubsub_messages', expect.any(Object));
});

test('MessageRepository - create should throw error for invalid topic name', async () => {
  const messageData: CreateMessageData = {
    messageId: 'msg-123',
    topic: 'invalid-topic-name',
    size: 0
  };

  await expect(repository.create(messageData)).rejects.toThrow(ValidationError);
  await expect(repository.create(messageData)).rejects.toThrow('Invalid topic name');
});

test('MessageRepository - create should handle minimal message data', async () => {
  const messageData: CreateMessageData = {
    messageId: 'msg-123',
    topic: 'projects/test-project/topics/test-topic',
    size: 0
  };

  const message = await repository.create(messageData);

  expect(message.data).toBeUndefined();
  expect(message.attributes).toEqual({});
  expect(message.orderingKey).toBeUndefined();
  expect(message.size).toBe(0);
  expect(message.deliveryAttempts).toBe(0);
  expect(message.acknowledged).toBe(false);
});

test('MessageRepository - findById should return message if exists', async () => {
  const mockStorageRecord = {
    id: 'msg-123',
    createdAt: '2024-01-01T00:00:00.000Z',
    updatedAt: '2024-01-01T00:00:00.000Z',
    messageId: 'msg-456',
    topic: 'projects/test-project/topics/test-topic',
    data: 'SGVsbG8gV29ybGQ=', // Base64 "Hello World"
    attributes: JSON.stringify({ key: 'value' }),
    publishTime: '2024-01-01T00:00:00.000Z',
    orderingKey: 'order-1',
    size: 11,
    deliveryAttempts: 0,
    acknowledged: 0,
    projectId: 'test-project',
    topicId: 'test-topic'
  };

  mockResolvedValueOnce(mockStorage.findById, mockStorageRecord);

  const message = await repository.findById('msg-123');

  expect(message).toBeDefined();
  expect(message?.id).toBe('msg-123');
  expect(message?.messageId).toBe('msg-456');
  expect(message?.topic).toBe('projects/test-project/topics/test-topic');
  expect(message?.data).toBe('SGVsbG8gV29ybGQ=');
  expect(message?.attributes).toEqual({ key: 'value' });
  expect(message?.orderingKey).toBe('order-1');
  expect(message?.size).toBe(11);
  expect(message?.deliveryAttempts).toBe(0);
  expect(message?.acknowledged).toBe(false);
  expect(message?.projectId).toBe('test-project');
  expect(message?.topicId).toBe('test-topic');
});

test('MessageRepository - findById should return null if not exists', async () => {
  mockResolvedValueOnce(mockStorage.findById,null);

  const message = await repository.findById('non-existent');

  expect(message).toBeNull();
});

test('MessageRepository - findByMessageId should return message if exists', async () => {
  const mockStorageRecord = {
    id: 'msg-123',
    createdAt: '2024-01-01T00:00:00.000Z',
    updatedAt: '2024-01-01T00:00:00.000Z',
    messageId: 'msg-456',
    topic: 'projects/test-project/topics/test-topic',
    attributes: JSON.stringify({}),
