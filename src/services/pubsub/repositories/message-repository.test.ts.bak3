test('MessageRepository - find should return messages matching criteria', async () => {
  const mockStorageResult: QueryResult<Record<string, unknown>> = {
    items: [
      {
        id: 'msg-1',
        createdAt: '2024-01-01T00:00:00.000Z',
        updatedAt: '2024-01-01T00:00:00.000Z',
        messageId: 'msg-1-id',
        topic: 'projects/test-project/topics/test-topic',
        attributes: JSON.stringify({ env: 'test' }),
        publishTime: '2024-01-01T00:00:00.000Z',
        size: 10,
        deliveryAttempts: 0,
        acknowledged: 0,
        projectId: 'test-project',
        topicId: 'test-topic'
      },
      {
        id: 'msg-2',
        createdAt: '2024-01-01T00:00:00.000Z',
        updatedAt: '2024-01-01T00:00:00.000Z',
        messageId: 'msg-2-id',
        topic: 'projects/test-project/topics/test-topic',
        attributes: JSON.stringify({ env: 'prod' }),
        publishTime: '2024-01-01T00:00:00.000Z',
        size: 20,
        deliveryAttempts: 1,
        acknowledged: 1,
        projectId: 'test-project',
        topicId: 'test-topic'
      }
    ],
    totalCount: 2,
    hasMore: false
  };

  mockResolvedValueOnce(mockStorage.find,mockStorageResult);

  const result = await repository.find({ topic: 'projects/test-project/topics/test-topic' });

  expect(result.items).toHaveLength(2);
  expect(result.items[0].messageId).toBe('msg-1-id');
  expect(result.items[0].attributes).toEqual({ env: 'test' });
  expect(result.items[0].acknowledged).toBe(false);
  expect(result.items[1].messageId).toBe('msg-2-id');
  expect(result.items[1].attributes).toEqual({ env: 'prod' });
  expect(result.items[1].acknowledged).toBe(true);
  expect(result.totalCount).toBe(2);
  expect(result.hasMore).toBe(false);
});

test('MessageRepository - findByTopic should filter by topic', async () => {
  const mockStorageResult: QueryResult<Record<string, unknown>> = {
    items: [],
    totalCount: 0,
    hasMore: false
  };

  mockResolvedValueOnce(mockStorage.find,mockStorageResult);

  await repository.findByTopic('projects/test-project/topics/test-topic', { limit: 10 });

  expect(mockStorage.find).toHaveBeenCalledWith('pubsub_messages', {
    limit: 10,
    topic: 'projects/test-project/topics/test-topic',
    filter: {
      conditions: [{ field: 'topic', operator: 'eq', value: 'projects/test-project/topics/test-topic' }],
      operator: 'and'
    }
  });
});

