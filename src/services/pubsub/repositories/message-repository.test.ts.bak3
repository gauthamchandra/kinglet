test('MessageRepository - findAvailableMessages should filter by acknowledgment and expiration', async () => {
  const mockStorageResult: QueryResult<Record<string, unknown>> = {
    items: [],
    totalCount: 0,
    hasMore: false
  };

  mockResolvedValueOnce(mockStorage.find,mockStorageResult);

  await repository.findAvailableMessages({ projectId: 'test-project' });

  expect(mockStorage.find).toHaveBeenCalledWith('pubsub_messages', {
    projectId: 'test-project',
    acknowledged: false,
    notExpired: true,
    filter: {
      conditions: [
        { field: 'projectId', operator: 'eq', value: 'test-project' },
        { field: 'acknowledged', operator: 'eq', value: 0 }
      ],
      operator: 'and'
    }
  });
});

test('MessageRepository - updateById should update existing message', async () => {
  const existingMessage: MessageRecord = {
    id: 'msg-123',
    createdAt: new Date('2024-01-01'),
    updatedAt: new Date('2024-01-01'),
    messageId: 'msg-456',
    topic: 'projects/test-project/topics/test-topic',
    attributes: {},
    publishTime: new Date('2024-01-01'),
    size: 0,
    deliveryAttempts: 0,
    acknowledged: false,
    projectId: 'test-project',
    topicId: 'test-topic'
  };

  mockResolvedValueOnce(mockStorage.findById,{
    id: existingMessage.id,
    createdAt: existingMessage.createdAt.toISOString(),
    updatedAt: existingMessage.updatedAt.toISOString(),
    messageId: existingMessage.messageId,
    topic: existingMessage.topic,
    attributes: JSON.stringify(existingMessage.attributes),
    publishTime: existingMessage.publishTime.toISOString(),
    size: existingMessage.size,
    deliveryAttempts: existingMessage.deliveryAttempts,
    acknowledged: existingMessage.acknowledged ? 1 : 0,
    projectId: existingMessage.projectId,
    topicId: existingMessage.topicId
  });

  const updateData = {
    deliveryAttempts: 2,
    acknowledged: true,
    ackId: 'ack-123',
    acknowledgedAt: new Date()
  };

  const updatedMessage = await repository.updateById('msg-123', updateData);

  expect(updatedMessage).toBeDefined();
  expect(updatedMessage?.deliveryAttempts).toBe(2);
  expect(updatedMessage?.acknowledged).toBe(true);
  expect(updatedMessage?.ackId).toBe('ack-123');
  expect(updatedMessage?.acknowledgedAt).toBeInstanceOf(Date);
  expect(updatedMessage?.updatedAt.getTime()).toBeGreaterThan(existingMessage.updatedAt.getTime());
  expect(mockStorage.updateById).toHaveBeenCalledWith('pubsub_messages', 'msg-123', expect.any(Object));
});

test('MessageRepository - updateById should return null for non-existent message', async () => {
  mockResolvedValueOnce(mockStorage.findById,null);

  const result = await repository.updateById('non-existent', { deliveryAttempts: 1 });

  expect(result).toBeNull();
  expect(mockStorage.updateById).not.toHaveBeenCalled();
});

