{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.ts"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreFiles": ["src/**/index.ts", "src/__fixtures__/**", "src/services/memorystore/__fixtures__/**"],
  "ignoreIssues": {
    "src/core/gateway/proto-types.ts": ["types"],
    "src/shared/types/index.ts": ["types"],
    "src/core/discovery/discovery-endpoints.ts": ["exports"],
    "src/core/discovery/service-registry.ts": ["exports"],
    "src/core/gateway/request-router.ts": ["exports"],
    "src/core/gateway/service-dispatcher.ts": ["exports"]
  }
}
