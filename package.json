{
  "name": "kinglet",
  "version": "2.2.0",
  "description": "kinglet - a local emulator for Google Cloud Platform services",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauthamchandra/kinglet.git"
  },
  "bugs": {
    "url": "https://github.com/gauthamchandra/kinglet/issues"
  },
  "homepage": "https://github.com/gauthamchandra/kinglet#readme",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build --target=bun --outdir=dist src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage src/ test-utils/ scripts/",
    "test:coverage:check": "bun test --coverage src/ test-utils/ scripts/ && bun run scripts/check-coverage.ts",
    "test:e2e": "cd e2e && bun test",
    "test:terraform": "./scripts/terraform-e2e.sh",
    "test:terraform:case": "./scripts/terraform-e2e.sh",
    "lint": "bunx tsc --noEmit && biome check src/ && knip",
    "lint:fix": "bunx tsc --noEmit && biome check --write src/",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "healthcheck": "bun run src/healthcheck.ts",
    "docs:generate": "bun run scripts/generate-docs.ts",
    "docs:generate:api": "bun run scripts/generate-docs.ts --api-only",
    "docs:generate:compatibility": "bun run scripts/generate-docs.ts --compatibility-only",
    "docs:check": "bun run scripts/generate-docs.ts --api-only && bun run scripts/check-generated-docs.ts",
    "knip": "knip",
    "setup:valkey": "bun run scripts/setup-valkey.ts",
    "postinstall": "bun run scripts/setup-valkey.ts --auto",
    "prepare": "husky"
  },
  "keywords": [
    "gcp",
    "google-cloud",
    "emulator",
    "pubsub",
    "scheduler",
    "tasks",
    "secrets-manager",
    "typescript",
    "bun"
  ],
  "author": "Gautham Chandra",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@google-cloud/alloydb": "3.0.0",
    "@google-cloud/kms": "^5.5.0",
    "@google-cloud/memorystore": "0.9.0",
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/scheduler": "^5.3.1",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/tasks": "^6.2.1",
    "@google-cloud/workflows": "4.3.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.2",
    "husky": "^9.1.7",
    "knip": "^5.85.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "cron-parser": "4.9.0",
    "js-yaml": "^4.1.1",
    "re2js": "^2.8.6",
    "zod": "^4.1.11"
  }
}
